# Скопируйте в .env и заполните. Файл .env не должен попадать в репозиторий и в браузер.
PORT=3000
SITE_URL=https://ваш-домен.ru           # публичный адрес сайта (для sitemap, canonical, Open Graph)
NODE_ENV=production
TRUST_PROXY=1                            # если сайт стоит за nginx/Cloudflare
ADMIN_PATH=staff                         # адрес админ-панели: https://ваш-домен.ru/staff — смените на свой
SESSION_SECRET=                          # длинная случайная строка (24+ символов); если пусто — создаётся data/secret.key

# Почта (SMTP). Без этих значений письма не отправляются — это видно в админке и в журнале.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Необязательно: Яндекс.Геокодер — точнее и стабильнее бесплатного OSM Nominatim
YANDEX_GEOCODER_KEY=
